{
  "name": "nextjs-supabase-starter",
  "version": "0.1.0",
  "private": true,
  "author": {
    "name": "progdper",
    "email": "progdper@gmail.com",
    "url": "https://progdper.github.io/"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/run-db.mjs sqlite dev",
    "build": "node scripts/run-db.mjs sqlite build",
    "start": "node scripts/run-db.mjs sqlite start",
    "postinstall": "node scripts/run-db.mjs auto generate",
    "typecheck": "node scripts/run-db.mjs sqlite typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "db:generate": "node scripts/run-db.mjs sqlite generate",
    "db:validate": "node scripts/run-db.mjs sqlite validate",
    "db:migrate:dev": "node scripts/run-db.mjs sqlite migrate",
    "db:migrate:deploy": "node scripts/run-db.mjs sqlite deploy",
    "db:studio": "node scripts/run-db.mjs sqlite studio",
    "dev:sqlite": "node scripts/run-db.mjs sqlite dev",
    "build:sqlite": "node scripts/run-db.mjs sqlite build",
    "start:sqlite": "node scripts/run-db.mjs sqlite start",
    "typecheck:sqlite": "node scripts/run-db.mjs sqlite typecheck",
    "check:sqlite": "npm run typecheck:sqlite && npm run lint && npm run format:check",
    "db:sqlite:setup": "node scripts/run-db.mjs sqlite setup",
    "db:sqlite:generate": "node scripts/run-db.mjs sqlite generate",
    "db:sqlite:validate": "node scripts/run-db.mjs sqlite validate",
    "db:sqlite:migrate": "node scripts/run-db.mjs sqlite migrate",
    "db:sqlite:studio": "node scripts/run-db.mjs sqlite studio",
    "dev:supabase": "node scripts/run-db.mjs supabase dev",
    "build:supabase": "node scripts/run-db.mjs supabase build",
    "start:supabase": "node scripts/run-db.mjs supabase start",
    "typecheck:supabase": "node scripts/run-db.mjs supabase typecheck",
    "check:supabase": "npm run typecheck:supabase && npm run lint && npm run format:check",
    "db:supabase:generate": "prisma generate --config prisma.config.ts",
    "db:supabase:validate": "prisma validate --config prisma.config.ts",
    "db:supabase:migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "db:supabase:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "db:supabase:studio": "prisma studio --config prisma.config.ts",
    "db:supabase:check": "tsx scripts/check-db.ts",
    "db:check": "tsx scripts/check-sqlite.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "dotenv": "^17.0.0",
    "next": "16.4.3",
    "pg": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "server-only": "0.0.1",
    "zod": "^4.0.0",
    "@prisma/adapter-better-sqlite3": "7.10.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "prisma": "^7.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "~5.9.0"
  },
  "license": "MIT"
}
