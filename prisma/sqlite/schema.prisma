generator client {
  provider = "prisma-client"
  output   = "../../src/generated_prisma"
}

datasource db {
  provider = "sqlite"
}

/// 로컬 개발용 앱 회원 정보입니다. 로그인·인증 연결은 미구현입니다.
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
